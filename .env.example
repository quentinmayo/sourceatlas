# Copy to .env and replace all three secrets (e.g. openssl rand -hex 32).
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
NEO4J_DATABASE=neo4j
READ_TOKEN=replace-with-a-random-reader-token
WRITE_TOKEN=replace-with-a-different-collector-token
SOURCEATLAS_URL=http://127.0.0.1:4000/graphql
HOST=127.0.0.1
PORT=4000
